# Keys for ~/.claude/bin/decide. Paste ONE key after the "=" (no quotes, no spaces).
# If both are filled in, OpenRouter is used.
# Keep this file private (the installer sets chmod 600). Never commit or share it.

# --- Option 1: OpenRouter (free Decider models) ---
# Get a key at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# --- Option 2: Perplexity Decisions API ($0.02 / 1M input tokens; Flash $0.01) ---
# Get a key at https://console.perplexity.ai
PERPLEXITY_API_KEY=

# --- Optional: override the model ---
# OpenRouter:  perplexity/pplx-decider-v1.3:free        (default, 27B)
#              perplexity/pplx-decider-flash-v1.3:free  (smaller, 4B)
# Perplexity:  pplx-decider-v1.3                        (default, 27B)
#              pplx-decider-flash-v1.3                  (smaller, 4B)
# DECIDER_MODEL=
