#!/usr/bin/env python3
"""decide: ask Perplexity Decider to pick one option.
usage: decide "QUESTION" OPTION[=description] OPTION[=description] [...] <<< "context"

Keys come from the environment or from ~/.claude/decider.env.
OpenRouter is used when OPENROUTER_API_KEY is set, else Perplexity's own API.
"""
import json, os, sys, time, urllib.request, urllib.error
CLAUDE_DIR = os.environ.get("CLAUDE_CONFIG_DIR") or os.path.expanduser("~/.claude")

ENV_FILE = os.path.join(CLAUDE_DIR, "decider.env")

def load_env_file():
    try:
        with open(ENV_FILE) as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                k, v = line.split("=", 1)
                k, v = k.strip(), v.strip().strip('"').strip("'")
                if v and not os.environ.get(k):
                    os.environ[k] = v
    except FileNotFoundError:
        pass

def main():
    load_env_file()
    if os.environ.get("OPENROUTER_API_KEY"):
        key_var = "OPENROUTER_API_KEY"
        url = "https://openrouter.ai/api/alpha/decisions"
        default_model = "perplexity/pplx-decider-v1.3:free"
    else:
        key_var = "PERPLEXITY_API_KEY"
        url = "https://api.perplexity.ai/v1/decisions"
        default_model = "pplx-decider-v1.3"
    model = os.environ.get("DECIDER_MODEL") or default_model

    if len(sys.argv) < 4:
        sys.exit("usage: decide QUESTION OPTION OPTION [...] < context")
    key = os.environ.get(key_var) or sys.exit(
        f"no API key: paste one into {ENV_FILE}")
    question = sys.argv[1]
    # an option may carry a description: "name=what it means"
    criteria = {}
    for o in sys.argv[2:]:
        name, _, desc = o.partition("=")
        criteria[name.strip()] = desc.strip() or None
    options = list(criteria)
    state = "" if sys.stdin.isatty() else sys.stdin.read().strip()
    body = {
        "model": model,
        "state": state or question,
        "questions": {"pick": {"type": "choice", "instructions": question,
                               "criteria": criteria}},
    }
    t0 = time.time()
    req = urllib.request.Request(url, data=json.dumps(body).encode(), headers={
        "Authorization": f"Bearer {key}", "Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=10) as r:
            a = json.load(r)["answers"]["pick"]
    except urllib.error.HTTPError as e:
        sys.exit(f"decider error {e.code}: {e.read().decode()[:300]}")
    if "choice" not in a:  # OpenRouter can return a refusal answer
        sys.exit(f"decider gave no choice: {json.dumps(a)[:300]}")
    conf = a.get("confidence")  # optional on OpenRouter
    print(json.dumps({"choice": a["choice"],
                      "confidence": round(conf, 3) if conf is not None else None}))
    log_to_monitor(question, options, a["choice"], conf, time.time() - t0)

def log_to_monitor(question, options, choice, conf, secs):
    """Append to the agent monitor log, only while the monitor is on."""
    d = os.environ.get("MONITOR_DIR") or os.path.join(CLAUDE_DIR, "monitor")
    if not os.path.exists(os.path.join(d, "on")):
        return
    try:
        ev = {"t": time.time(), "ev": "Decide", "q": question[:160], "options": options,
              "choice": choice, "conf": round(conf, 3) if conf is not None else None,
              "ms": int(secs * 1000)}
        with open(os.path.join(d, "events.jsonl"), "a", encoding="utf-8") as f:
            f.write(json.dumps(ev, ensure_ascii=False) + "\n")
    except OSError:
        pass

if __name__ == "__main__":
    main()
